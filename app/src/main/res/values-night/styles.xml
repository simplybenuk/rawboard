<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:colorBackgroundFloating">@color/surface</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorForeground">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:colorControlNormal">@color/muted</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlHighlight">@color/control_highlight</item>
        <item name="android:editTextColor">@color/ink</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="KeyboardTheme" parent="android:style/Theme.DeviceDefault.InputMethod">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:colorForeground">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
